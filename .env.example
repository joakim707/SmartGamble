# football-data.org API key (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=your_key_here

# the-odds-api.com API key (https://the-odds-api.com/)
ODDS_API_KEY=your_odds_api_key_here

# Supabase – project URL (sans /rest/v1/)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anon/publishable — lecture seule, contrainte par les policies RLS.
# Utilisée par le frontend (NEXT_PUBLIC_SUPABASE_ANON_KEY) et par les
# scripts qui ne font que lire (data/predict.py, data/api_predict.py).
SUPABASE_KEY=your_supabase_anon_key_here

# Clé secret/service_role — contourne RLS, réservée aux scripts qui
# écrivent en base (data/fetch_*.py, merge_teams.py, find_duplicates.py).
# Ne jamais l'exposer côté client (pas de préfixe NEXT_PUBLIC_).
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Hugging Face API key (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Clé d'authentification de l'API de prédiction (data/api_predict.py),
# attendue dans l'en-tête X-API-Key. Génère une valeur aléatoire, ex. :
# python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your_random_secret_key_here

# PostgreSQL local (docker-compose)
POSTGRES_USER=smartgamble
POSTGRES_PASSWORD=smartgamble
POSTGRES_DB=smartgamble
DATABASE_URL=postgresql://smartgamble:smartgamble@localhost:5432/smartgamble
