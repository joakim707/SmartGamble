# football-data.org API key (https://www.football-data.org/)
FOOTBALL_DATA_API_KEY=your_key_here

# the-odds-api.com API key (https://the-odds-api.com/)
ODDS_API_KEY=your_odds_api_key_here

# Supabase – project URL (sans /rest/v1/) et clé anon
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Hugging Face API key (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# PostgreSQL local (docker-compose)
POSTGRES_USER=smartgamble
POSTGRES_PASSWORD=smartgamble
POSTGRES_DB=smartgamble
DATABASE_URL=postgresql://smartgamble:smartgamble@localhost:5432/smartgamble
