# Copier ce fichier en .env.local puis renseigner les vraies valeurs :
#   cp .env.local.example .env.local

# Supabase – URL du projet et clé publique (anon)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co/"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# API de prédiction (data/api_predict.py) — lancée en local à côté du dashboard
NEXT_PUBLIC_PREDICT_API_URL="http://localhost:5000"

# Doit correspondre exactement à API_SECRET_KEY dans le .env racine (celui
# lu par data/api_predict.py) — voir .env.example à la racine du projet.
NEXT_PUBLIC_PREDICT_API_KEY="your_random_secret_key_here"
